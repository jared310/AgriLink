# ============================================
# AgriLink Backend Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Flask Configuration ---
FLASK_ENV=production
DEBUG=False

# --- Database Configuration ---
# Render and modern hosts provide a single DATABASE_URL value.
# Example: postgres://user:password@hostname:5432/agrilink_db
DATABASE_URL=postgres://user:password@hostname:5432/agrilink_db

# --- Flask Configuration ---
FLASK_ENV=production
DEBUG=False

# --- JWT Configuration ---
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- CORS Configuration ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com,https://www.yourdomain.com

# --- API Configuration ---
MAX_UPLOAD_SIZE_MB=16
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD_SECONDS=60

# --- Email Configuration (optional, for notifications) ---
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# --- Deployment Notes ---
# Before deploying to production:
# 1. Generate a strong JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# 2. Set DB_PASSWORD to a strong password
# 3. Update ALLOWED_ORIGINS with your actual domain
# 4. Use environment variables or secrets management tool (AWS Secrets Manager, etc.)
# 5. Never commit the actual .env file - only commit .env.example
